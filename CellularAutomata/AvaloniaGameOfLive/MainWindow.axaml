<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaGameOfLive="clr-namespace:AvaloniaGameOfLive"
        mc:Ignorable="d"
        x:Class="AvaloniaGameOfLive.MainWindow"
        Width="1280" Height="720"
        Title="AvaloniaGameOfLive"
        >
    <Grid ColumnDefinitions="810, *" RowDefinitions="20, 610, *">
        <TextBlock x:Name="statusLabel"
               Grid.Column="0" 
               Grid.Row="0"  Text="Generation"
               Margin="5"
               />
        <avaloniaGameOfLive:SkiaCanvasControl x:Name="GameOfLiveView" 
                           Grid.Column="0" 
                           Grid.Row="1"
                           Height="600"
                           Width="800"
                           Margin="5">
        </avaloniaGameOfLive:SkiaCanvasControl>       
    
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" Spacing="5" Margin="5,0,5,0" Name="FramePanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10"  >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="10" Margin="5,5,65,5" Name="ButtonStack">
                    <Button x:Name="btnStart"
                            Content="Start"
                            Width="95"
                            HorizontalContentAlignment="Center"/>
                    <Button x:Name="btnStop"
                            Content="Stop" 
                            Width="95"
                            HorizontalContentAlignment="Center"/>
                    <Button x:Name="btnSingleStep"
                            Content="Next Step"
                            Width="95"
                            HorizontalContentAlignment="Center" />
                    <Button x:Name="btnReset"
                            Content="Reset"
                            Width="95"
                            HorizontalContentAlignment="Center"
                            Click="btnReset_Click"/>
                </StackPanel> 
                
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="10" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblProbability" Text="Wahrscheinlichkeit" VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="probabilitySelector"
                                       Minimum="0"
                                       Maximum="1"
                                       Value="0.2"
                                       Increment="0.1"
                                       Width="120"
                                       HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblRuleSet" Text="Regeln" VerticalAlignment="Center" Width="75"/>
                        <ComboBox x:Name="cbRuleSet" HorizontalAlignment="Right" Width="170" SelectedIndex="0">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Game of Life" />
                                <ComboBoxItem Content="Sand" />
                                <ComboBoxItem Content="Game of Life Array" />
                                <ComboBoxItem Content="Sand Array" />
                                <ComboBoxItem Content="Wolfram Array" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblProcessorCount" Text="Cores" VerticalAlignment="Center" Width="75"/>
                        <NumericUpDown x:Name="processorCountSelector"
                                       Minimum="1"
                                       Maximum="32"
                                       Value="8"
                                       Increment="1"
                                       Width="170"
                                       HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblPattern" Text="Muster" VerticalAlignment="Center" Width="75"/>
                        <!-- Pattern-Auswahl -->
                        <ComboBox x:Name="cbPattern" 
                                  HorizontalAlignment="Right" 
                                  Width="170" 
                                  SelectedIndex="0"
                        >
                            <ComboBox.Items>
                                <ComboBoxItem Content="Random" />
                                <ComboBoxItem Content="Schachbrett" />
                                <ComboBoxItem Content="Free Style" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblCellSize" Text="Zellgröße" VerticalAlignment="Center" Width="75"/>
                        <NumericUpDown x:Name="cellSizeSelector"
                                       Minimum="1"
                                       Maximum="64"
                                       Value="4"
                                       Increment="1"
                                       Width="170"
                                       HorizontalAlignment="Right"/>
                    </StackPanel>
            
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="lblEngine" Text="Engine" VerticalAlignment="Center" Width="75"/>
                        <ComboBox x:Name="cbEngine" HorizontalAlignment="Right" Width="170" SelectedIndex="0">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Rect" />
                                <ComboBoxItem Content="Point" />
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>
                </StackPanel> 
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12" Margin="5,5,5,0" Name="SpawnPanel">
                <CheckBox x:Name="cbBrushActive" Content="Zeichnen" VerticalAlignment="Center" Width="97" IsChecked="True" Margin="5,0,60,0"/>
                <TextBlock x:Name="lblBrushSize" Text="Pinselsize" VerticalAlignment="Center" Width="75"/>
                <NumericUpDown x:Name="brushSizeSelector"
                               Minimum="1"
                               Maximum="20"
                               Value="10"
                               Increment="1"
                               Width="170"
                               />
            </StackPanel>
            <Panel HorizontalAlignment="Left" Margin="5,0,5,0" Name="UsePanel">
                <CheckBox x:Name="cbUseProbability" Content="Wahrscheinlichkeit nutzen" VerticalAlignment="Center" IsChecked="True" Margin="5,0,0,0"/>
            </Panel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12" Margin="5,15,5,5" Name="StopWatchPanel">
                <CheckBox x:Name="cbStopWatch" Content="Messung" VerticalAlignment="Center" Width="97" IsChecked="True" Margin="5,0,60,5"/>
                <TextBlock x:Name="lblStopWatch" Text="Durchläufe" VerticalAlignment="Center" Width="75"/>
                <NumericUpDown x:Name="stopWatchCountSelector"
                               Minimum="1"
                               Maximum="10000"
                               Value="50"
                               Increment="1"
                               Width="170"
                />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="tbStopWatch"
                         Text="Statistik"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         Height="305"
                         Width="430" />

            </ScrollViewer>
        </StackPanel>
  </Grid>
</Window>
